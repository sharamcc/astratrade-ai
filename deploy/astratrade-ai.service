[Unit]
Description=AstraTrade AI test application
After=network.target

[Service]
Type=simple
User=astratrade
Group=astratrade
WorkingDirectory=/opt/astratrade-ai/current
EnvironmentFile=/etc/astratrade-ai/astratrade-ai.env
ExecStart=/usr/bin/python3 /opt/astratrade-ai/current/serve.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/astratrade-ai

[Install]
WantedBy=multi-user.target
